{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "The server keeps MCP sessions in memory and supports exactly one replica."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-fA-F]{64})$" }
      },
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"],
            "additionalProperties": false
          }
        ]
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "auth": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "existingSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "key"],
          "additionalProperties": false
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(|https://.+)$",
              "description": "Absolute https URL of the authorization server. Must equal the iss claim exactly."
            },
            "resourceURL": {
              "type": "string",
              "pattern": "^(|https://[^?#]*[^/?#])$",
              "description": "This server's canonical resource URI and required audience: lowercase https, no query, no fragment, no trailing slash."
            },
            "jwksURI": { "type": "string", "pattern": "^(|https://.+)$" },
            "subjectClaim": { "type": "string" },
            "groupsClaim": { "type": "string" },
            "nameClaims": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "allowedAlgorithms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "clockSkew": {
              "type": "string",
              "pattern": "^(|[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*)$",
              "description": "Go duration (supports composite values like 1m30s), e.g. 60s. Empty means the server default."
            }
          },
          "required": [
            "issuer", "resourceURL", "jwksURI", "subjectClaim", "groupsClaim",
            "nameClaims", "allowedAlgorithms", "clockSkew"
          ],
          "additionalProperties": false
        }
      },
      "required": ["token", "existingSecret", "oidc"],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "readinessMode": { "type": "string", "enum": ["kubernetes", "process"] }
      },
      "required": ["port", "logLevel", "readinessMode"],
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      },
      "required": ["create", "automount", "annotations", "name"],
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "requestApiGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": { "const": "*" },
            "description": "A named API group. \"*\" is rejected because it also matches the core group, where list on secrets returns their values."
          },
          "description": "API groups holding Promise-defined request resources. Empty means requests cannot be submitted. Ignored when impersonation.enabled is true."
        },
        "impersonation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "userPrefix": { "type": "string" },
            "groupPrefix": { "type": "string" },
            "clientPrefix": { "type": "string", "minLength": 1 },
            "clientGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "groupAllowlist": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "required": ["enabled", "userPrefix", "groupPrefix", "clientPrefix", "clientGroups", "groupAllowlist"],
          "additionalProperties": false
        }
      },
      "required": ["create", "requestApiGroups", "impersonation"],
      "additionalProperties": false
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      },
      "required": ["type", "port", "annotations"],
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": { "secretName": { "type": "string" } },
          "required": ["secretName"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "className", "annotations", "host", "tls"],
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" }
  },
  "required": [
    "replicaCount", "image", "imagePullSecrets", "nameOverride", "fullnameOverride",
    "auth", "config", "serviceAccount", "rbac", "podAnnotations", "podLabels",
    "podSecurityContext", "securityContext", "service", "ingress", "resources",
    "startupProbe", "livenessProbe", "readinessProbe", "priorityClassName",
    "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"
  ],
  "additionalProperties": false,
  "definitions": {
    "intOrString": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 65535 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "execAction": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "grpcAction": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": { "type": "string" }
      },
      "required": ["port"],
      "additionalProperties": false
    },
    "httpGetAction": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "httpHeaders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          }
        },
        "path": { "type": "string" },
        "port": { "$ref": "#/definitions/intOrString" },
        "scheme": { "type": "string", "enum": ["HTTP", "HTTPS"] }
      },
      "required": ["port"],
      "additionalProperties": false
    },
    "tcpSocketAction": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "$ref": "#/definitions/intOrString" }
      },
      "required": ["port"],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "exec": { "$ref": "#/definitions/execAction" },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "grpc": { "$ref": "#/definitions/grpcAction" },
        "httpGet": { "$ref": "#/definitions/httpGetAction" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "tcpSocket": { "$ref": "#/definitions/tcpSocketAction" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["enabled"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "oneOf": [
              { "required": ["exec"] },
              { "required": ["grpc"] },
              { "required": ["httpGet"] },
              { "required": ["tcpSocket"] }
            ]
          }
        }
      ]
    }
  }
}
